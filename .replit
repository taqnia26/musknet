modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["glib", "nss", "nspr", "dbus", "atk", "cups", "libdrm", "expat", "xorg.libX11", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXrandr", "mesa", "libgbm", "pango", "cairo", "alsa-lib", "libxkbcommon", "at-spi2-atk", "gtk3", "xorg.libxcb", "xorg.libXcursor", "xorg.libXi", "xorg.libXtst"]

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 19126
externalPort = 3000

[userenv]

[userenv.shared]
VAT_SELLER_LEGAL_NAME = "مؤسسة مسك اللولو للتجارة"
